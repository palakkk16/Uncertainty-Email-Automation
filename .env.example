# Copy this file to .env and replace every placeholder. .env is gitignored.
# Paths are relative to the project root unless you use an absolute path.
# Use your own Gmail addresses. Do not commit real addresses or client secrets.
CREDENTIALS_PATH=credentials/client_secret.json
TOKEN_PATH=credentials/token.json
GMAIL_SENDER=your-sender@gmail.com
TEST_RECIPIENT=your-recipient@gmail.com
TEST_SUBJECT=UNCERTAIN-EMAIL phase 1 test
TEST_BODY=Phase 1 connectivity check. No uncertainty logic in this send.

# Phase 2 bind address. Placeholders only.
APP_HOST=127.0.0.1
APP_PORT=8741

# Phase 3. Gemini API free tier via Google AI Studio, not Vertex AI.
# Create a key at https://aistudio.google.com/apikey and do not attach billing.
GEMINI_API_KEY=
# Free-tier Flash. Do not switch this to a Pro or paid-only model.
GEMINI_MODEL=gemini-flash-latest

# Phase 7. Real Gmail dispatch when POST /chat decides SEND. Off unless true.
# Uses GMAIL_SENDER and the TOKEN_PATH created by scripts/gmail_send_test.py.
# Locally APP_HOST must stay on loopback unless APP_REQUIRE_USER_GMAIL_TOKEN
# is true. Set that flag true on Render so public users cannot send from the
# server token.json.
APP_DISPATCH_ENABLED=false
APP_REQUIRE_USER_GMAIL_TOKEN=false
# Comma-separated browser origins. Render should include the Vercel URL.
APP_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
# When true (default), any valid recipient address may be used. Set false to
# enforce APP_DISPATCH_ALLOWED_RECIPIENTS / DISPATCH_ALLOWLIST.
APP_ALLOW_ALL_RECIPIENTS=true
# Optional comma-separated allowlist. Used only when APP_ALLOW_ALL_RECIPIENTS
# is false. Empty also means any address the user wrote.
# DISPATCH_ALLOWLIST and ALLOWED_RECIPIENTS are aliases merged into this list.
APP_DISPATCH_ALLOWED_RECIPIENTS=
DISPATCH_ALLOWLIST=

# Google Identity Services. Use a Web OAuth client ID (not the Gmail desktop
# client). Authorized JavaScript origin: http://127.0.0.1:43123
APP_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Empty locally so Vite's proxy is used. On Vercel set the Render API URL.
VITE_API_BASE_URL=

# Email/password accounts. Demo users are seeded on startup:
# admin@uncertain.ai / Demo@1234 and palak@gmail.com / Palak@123
APP_USERS_PATH=data/users.json

# First name used in drafted email sign-offs.
APP_SIGNER_NAME=Palak
